APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=5433
POSTGRES_DB=rag
POSTGRES_USER=rag
# Required: set your own non-empty password locally.
POSTGRES_PASSWORD=
DB_ECHO=false

# Required: generate at least 32 random bytes; never commit the real value.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Dedicated local database; integration tests clean users and tenants here.
TEST_DATABASE_NAME=rag_test
