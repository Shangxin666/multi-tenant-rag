APP_ENV=local
DB_HOST=127.0.0.1
DB_PORT=5433
POSTGRES_DB=rag
POSTGRES_USER=rag
# Required: set your own non-empty password locally.
POSTGRES_PASSWORD=
# M6: separate credentials; generate different random values locally.
# POSTGRES_* credentials are for Compose/provisioning/maintenance only.
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
DB_ECHO=false

# Required: generate at least 32 random bytes; never commit the real value.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Dedicated local database; integration tests clean users and tenants here.
TEST_DATABASE_NAME=rag_test

DOCUMENT_STORAGE_ROOT=.data/documents
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_REQUEST_BYTES=11534336
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
MAX_PDF_PAGES=200
MAX_PARSED_CHARS=2000000
MAX_DOCUMENT_CHUNKS=5000

EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32
# Set locally. Never commit a real API key.
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=2048
MAX_RAG_CONTEXT_CHARS=12000

DENSE_CANDIDATE_K=30
SPARSE_CANDIDATE_K=30
RRF_K=60
RERANK_CANDIDATE_K=30
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_DEVICE=cpu
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512

AGENT_MAX_CONCURRENT=2
AGENT_TIMEOUT_SECONDS=120
AGENT_MODEL_TIMEOUT_SECONDS=30
AGENT_TOOL_TIMEOUT_SECONDS=30

# M9: payload-free local traces, disabled by default
TRACE_ENABLED=false
TRACE_PATH=.data/traces/runs.jsonl
